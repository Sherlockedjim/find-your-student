# Frontend values are public. Never add server secrets with a VITE_ prefix.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_AMAP_JS_KEY=
# Optional controlled JS API proxy URL ending in /_AMapService
VITE_AMAP_PROXY_URL=

# Server-only values: configure in Supabase Edge Functions > Secrets.
# AMAP_WEB_SERVICE_KEY
# AMAP_SECURITY_JS_CODE
# DEEPSEEK_API_KEY
